
pipeline {
    agent any

    stages {
        stage('Cleanup Old Containers') {
            steps {
                bat 'docker rm -f dev-container test-container || exit /b 0'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Program9') {
                    bat 'docker build -t flaskapp .'
                }
            }
        }

        stage('Run Dev Container') {
            steps {
                bat 'docker run -d --name dev-container -p 6002:5000 flaskapp'
            }
        }

        stage('Run Test Container') {
            steps {
                bat 'docker run -d --name test-container -p 6001:5000 flaskapp'
            }
        }
    }
}
